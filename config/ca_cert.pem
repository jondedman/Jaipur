# filepath: /Users/jondedman/code/twenty_four/Jaipur/config/initializers/redis.rb
require 'redis'
require 'certifi'

# Write the certifi CA bundle to a custom CA file
ca_file_path = Rails.root.join('config', 'ca_cert.pem')
File.write(ca_file_path, File.read(Certifi.where))

begin
  redis_url = ENV['REDIS_URL']
  puts "Initializing Redis with URL: #{redis_url}"
  $redis = Redis.new(
    url: redis_url,
    ssl: true,
    ssl_params: {
      verify_mode: OpenSSL::SSL::VERIFY_PEER,
      ca_file: ca_file_path.to_s  # Point to the custom CA file
    }
  )
  puts "Redis initialized successfully"
rescue => e
  puts "Error initializing Redis: #{e.message}"
  puts e.backtrace.join("\n")
  $redis = nil
end
